# Environment Configuration

# Application
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
TIMEZONE="Asia/Dhaka"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shordindu_internal?schema=public"

# Auth & Sessions
SESSION_SECRET="change-this-to-a-very-secure-random-secret-at-least-32-chars"
SESSION_MAX_AGE_DAYS=30

# Initial Bootstrap Admin (Module 1 Seed)
FIRST_ADMIN_EMAIL="admin@example.com"
FIRST_ADMIN_NAME="System Administrator"

# Email Configuration (console | smtp | resend)
EMAIL_PROVIDER="console"

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Resend Settings (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
RESEND_FROM="noreply@example.com"
