# Environment Configuration

# Application
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
TIMEZONE="Asia/Dhaka"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shordindu_internal?schema=public"

# Auth & Sessions
SESSION_SECRET="change-this-to-a-very-secure-random-secret-at-least-32-chars"
SESSION_MAX_AGE_DAYS=30

# Initial Bootstrap Admin (Module 1 Seed)
FIRST_ADMIN_EMAIL="admin@example.com"
FIRST_ADMIN_NAME="System Administrator"

# Email Configuration (console | smtp | resend)
EMAIL_PROVIDER="console"

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT=587
SMTP_FROM="noreply@example.com"

# Two accounts are used so reminder bursts can never exhaust the sign-in mail.
# Auth account: OTP, invite, approval, rejection.
SMTP_AUTH_USER=""
SMTP_AUTH_PASS=""
SMTP_AUTH_FROM="shordindu.otp@gmail.com"
# Bulk account: reminders, digests, announcements.
SMTP_BULK_USER=""
SMTP_BULK_PASS=""
SMTP_BULK_FROM="shordindu.noreply@gmail.com"

# Fallback when SMTP_AUTH_* / SMTP_BULK_* are not set (single-account setups).
SMTP_USER=""
SMTP_PASS=""

# Daily send caps per account, counted on the Asia/Dhaka calendar day.
# Set to 0 to disable the guard (useful in development).
EMAIL_AUTH_DAILY_LIMIT=300
EMAIL_BULK_DAILY_LIMIT=300
# Slots low-priority mail (digests) must leave for reminders.
EMAIL_LOW_PRIORITY_RESERVE=60

# Resend Settings (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
RESEND_FROM="noreply@example.com"
# Optional per-account keys; fall back to RESEND_API_KEY / RESEND_FROM above.
RESEND_AUTH_API_KEY=""
RESEND_AUTH_FROM=""
RESEND_BULK_API_KEY=""
RESEND_BULK_FROM=""

# Profile pictures (optional). Resized avatars live here, not in the database.
# Defaults to .data/avatars inside the project.
AVATAR_UPLOAD_DIR=""
