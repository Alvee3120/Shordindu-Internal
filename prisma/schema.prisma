datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Admin
  HR
  Manager
  Employee
}

enum UserStatus {
  Pending
  Active
  Rejected
  Disabled
}

enum OtpPurpose {
  register
  reset
}

enum TargetType {
  update
  comment
  assignment
  chatMessage
}

enum ReactionKind {
  like
  dislike
}

enum AssignmentPriority {
  normal
  urgent
}

enum AssignmentStatus {
  open
  completed
  cancelled
}

enum AssigneeStatus {
  pending
  in_progress
  done
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
}

model User {
  id              String     @id @default(uuid())
  name            String
  email           String     @unique
  phone           String?
  department      String
  position        String
  role            Role?
  status          UserStatus @default(Pending)
  passwordHash    String?    @map("password_hash")
  avatarFile      String?    @map("avatar_file")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  sessions            Session[]
  updates             Update[]
  comments            Comment[]
  reactions           Reaction[]
  mentions            Mention[]
  announcements       Announcement[]       @relation("AnnouncementCreatedBy")
  chatMessages        ChatMessage[]
  chatRead            ChatRead?
  calendarEvents      CalendarEvent[]
  assignmentsCreated  Assignment[]         @relation("AssignmentCreatedBy")
  assignmentAssignees AssignmentAssignee[]
  leaves              Leave[]              @relation("LeaveUser")
  leavesCreated       Leave[]              @relation("LeaveCreatedBy")
  leavesDecided       Leave[]              @relation("LeaveDecidedBy")
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@map("users")
}

model OtpCode {
  id        String     @id @default(uuid())
  email     String
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  attempts  Int        @default(0)
  usedAt    DateTime?  @map("used_at")
  requestIp String?    @map("request_ip")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@index([requestIp, createdAt])
  @@map("otp_codes")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Update {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  contentHtml String    @map("content_html")
  contentText String    @map("content_text")
  updateDate  DateTime  @map("update_date") @db.Date
  postedAt    DateTime  @default(now()) @map("posted_at")
  isLate      Boolean   @default(false) @map("is_late")
  editedAt    DateTime? @map("edited_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, updateDate])
  @@index([updateDate, userId])
  @@index([updateDate, postedAt])
  @@map("updates")
}

model Comment {
  id          String     @id @default(uuid())
  targetType  TargetType @map("target_type")
  targetId    String     @map("target_id")
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id])
  content     String
  createdAt   DateTime   @default(now()) @map("created_at")
  editedAt    DateTime?  @map("edited_at")
  deletedAt   DateTime?  @map("deleted_at")

  @@index([targetType, targetId])
  @@index([userId])
  @@map("comments")
}

model Reaction {
  id         String       @id @default(uuid())
  targetType TargetType   @map("target_type")
  targetId   String       @map("target_id")
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id])
  kind       ReactionKind
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([targetType, targetId, userId])
  @@index([targetType, targetId])
  @@map("reactions")
}

model Mention {
  id              String     @id @default(uuid())
  targetType      TargetType @map("target_type")
  targetId        String     @map("target_id")
  mentionedUserId String     @map("mentioned_user_id")
  mentionedUser   User       @relation(fields: [mentionedUserId], references: [id])
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([mentionedUserId])
  @@map("mentions")
}

model Assignment {
  id          String             @id @default(uuid())
  createdById String             @map("created_by")
  createdBy   User               @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  contentHtml String             @map("content_html")
  dueDate     DateTime?          @map("due_date") @db.Date
  priority    AssignmentPriority @default(normal)
  status      AssignmentStatus   @default(open)
  createdAt   DateTime           @default(now()) @map("created_at")
  editedAt    DateTime?          @map("edited_at")
  deletedAt   DateTime?          @map("deleted_at")

  assignees AssignmentAssignee[]

  @@index([status, dueDate])
  @@map("assignments")
}

model AssignmentAssignee {
  assignmentId String         @map("assignment_id")
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String         @map("user_id")
  user         User           @relation(fields: [userId], references: [id])
  status       AssigneeStatus @default(pending)
  doneNote     String?        @map("done_note")
  doneAt       DateTime?      @map("done_at")
  removedAt    DateTime?      @map("removed_at")

  @@id([assignmentId, userId])
  @@index([userId, status])
  @@map("assignment_assignees")
}

model Leave {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation("LeaveUser", fields: [userId], references: [id])
  fromDate    DateTime     @map("from_date") @db.Date
  toDate      DateTime     @map("to_date") @db.Date
  reason      String
  status      LeaveStatus  @default(Pending)
  decidedById String?      @map("decided_by")
  decidedBy   User?        @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?    @map("decided_at")
  createdById String       @map("created_by")
  createdBy   User         @relation("LeaveCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([userId, fromDate, toDate])
  @@index([status])
  @@map("leaves")
}

model Announcement {
  id          String    @id @default(uuid())
  createdById String    @map("created_by")
  createdBy   User      @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  title       String
  contentHtml String    @map("content_html")
  contentText String    @map("content_text")
  createdAt   DateTime  @default(now()) @map("created_at")
  editedAt    DateTime? @map("edited_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([createdAt])
  @@map("announcements")
}

model ChatMessage {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([createdAt])
  @@index([updatedAt])
  @@map("chat_messages")
}

model CalendarEvent {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  notes      String?
  eventDate  DateTime  @map("event_date") @db.Date
  remindedAt DateTime? @map("reminded_at")
  doneAt     DateTime? @map("done_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  editedAt   DateTime? @map("edited_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([userId, eventDate])
  @@index([eventDate, remindedAt])
  @@map("calendar_events")
}

model ChatRead {
  userId     String   @id @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now()) @map("last_read_at")

  @@map("chat_reads")
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String
  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([emailedAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

model JobRun {
  id             String   @id @default(uuid())
  job            String
  runDate        DateTime @db.Date @map("run_date")
  status         String
  detail         String?
  recipientCount Int      @default(0) @map("recipient_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([job, runDate])
  @@index([runDate])
  @@map("job_runs")
}
